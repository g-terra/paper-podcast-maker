{
  "name": "paper-podcast-maker",
  "private": true,
  "description": "Turn academic papers into podcast episodes, entirely on your own machine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @paper-podcast/web --filter @paper-podcast/server dev",
    "build": "pnpm -r build",
    "start": "node bin/ppm.mjs start",
    "stop": "node bin/ppm.mjs stop",
    "status": "node bin/ppm.mjs status",
    "ppm": "node bin/ppm.mjs",
    "setup": "node bin/ppm.mjs setup",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
